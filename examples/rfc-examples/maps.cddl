extensible-map-example = {
    ? "optional-key" => int,
    * tstr => any
}

extensible-map-example-2 = {
    ? "optional-key": int,
    * tstr => any
}

extensible-map-example-3 = {
    ? optional-key: int,
    * tstr => any
}

extensible-map-example-4 = {
    ? "optional-key" ^ => int,
    * tstr => any
}

example-map = {
    ? "hyphenated-key": text,
    ? "another-key": text,
    ? standardIdentifier: text,
    ? 1: text,
}