export const TerminalColorSchema: z.ZodLazy<typeof BasecolorsSchema> = z.lazy(() => BasecolorsSchema);
export const 
BasecolorsSchema: z.ZodLazy<z.ZodObject<{
"black":z.ZodLiteral<0>,"red":z.ZodLiteral<1>,"green":z.ZodLiteral<2>,"yellow":z.ZodLiteral<3>,"blue":z.ZodLiteral<4>,"magenta":z.ZodLiteral<5>,"cyan":z.ZodLiteral<6>,"white":z.ZodLiteral<7>}>> = z.lazy(() => z.object({
"black":z.literal(0),"red":z.literal(1),"green":z.literal(2),"yellow":z.literal(3),"blue":z.literal(4),"magenta":z.literal(5),"cyan":z.literal(6),"white":z.literal(7)}));
export const ExtendedColorSchema: z.ZodLazy<z.ZodIntersection<typeof BasecolorsSchema,z.ZodObject<{
"orange":z.ZodLiteral<8>,"pink":z.ZodLiteral<9>,"purple":z.ZodLiteral<10>,"brown":z.ZodLiteral<11>}>>> = z.lazy(() => BasecolorsSchema.and(
